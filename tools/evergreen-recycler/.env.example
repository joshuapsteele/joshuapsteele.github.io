# Generate the dashboard key with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
RECYCLER_ADMIN_TOKEN=
# Micro.blog Account → App tokens. This stays on the server, never in the browser.
MICROBLOG_TOKEN=
# Set to 1 only when ready to publish. Also resume the queue in the dashboard.
RECYCLER_LIVE=0
